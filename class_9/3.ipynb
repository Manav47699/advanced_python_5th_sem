     ]
    }
   ],
   "source": [
    "import random \n",
    "import numpy as np\n",
    "import time\n",
    "\n",
    "start = time.time()\n",
    "X = np.random.random(100000000)\n",
    "X = X+2\n",
    "end =  time.time()\n",
    "print (X[:5])\n",
    "# print(X[:5])\n",
    "print (f\"time taken = {end - start} seconds\")"
   ]
